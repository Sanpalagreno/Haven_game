; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Haven Game"
run/main_scene="res://start_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*uid://c5ui6ejmvb3d2"

[display]

window/size/viewport_width=1728
window/size/viewport_height=972
window/size/mode=2
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"

[gui]

theme/custom_font="res://assets/fonts/LilitaOne-Regular.ttf"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
environment/defaults/default_clear_color=Color(0.04, 0.05, 0.08, 1)
